# chineseMedicalLora 环境变量样例
# 复制为 .env 后按需修改。
# scripts/*.sh 与 src/{train,merge_lora,build_dataset,serve} 会自动加载项目根目录 .env
# （已 export 的环境变量优先，不会被覆盖）。

# ---- 基座模型 ----
# 须指向含 config.json 的本地目录（ModelScope/HF 缓存的 snapshot 亦可）
# AutoDL + modelscope 常见布局示例：
BASE_MODEL_PATH=/root/autodl-tmp/models/Qwen--Qwen2.5-7B-Instruct/snapshots/master

# ---- 推理时使用的合并后模型 ----
MERGED_MODEL_PATH=./outputs/merged_model

# ---- 数据 ----
RAW_DATA_DIR=./datasets
PROCESSED_DATA_DIR=./data/processed

# ---- 训练参数 ----
N_PER_DEPT=20000
MAX_CHAR_LEN=600
SEED=42

# ---- 推理服务 ----
HOST=0.0.0.0
PORT=8000

# ---- 生成参数 ----
MAX_NEW_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.1
