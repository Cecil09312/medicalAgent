# ============================================================
# MediX 医疗Agent - 环境配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# ----- LLM API 配置 (OpenAI 兼容) -----
LLM_API_KEY=your-llm-api-key
LLM_MODEL_NAME=your-model-name
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# 小模型配置（大模型降级与简单问题路由，未配置则禁用）
LLM_SMALL_MODEL_NAME=
LLM_SMALL_BASE_URL=
LLM_SMALL_API_KEY=

# 熔断器与路由配置
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=60
ROUTE_SIMPLE_MAX_LEN=30
# 二级路由 LLM 意图分类（可选，默认关闭）：开启后对临界长度（默认 15~60 字）且
# 不含复杂关键词的问题，用小模型做一次轻量分类再路由；需配置 LLM_SMALL_MODEL_NAME
ROUTE_LLM_CLASSIFY_ENABLED=false
ROUTE_LLM_BOUNDARY_MIN=15
ROUTE_LLM_BOUNDARY_MAX=60

# ----- 知识库 / 向量数据库配置 -----
KB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KB_EMBEDDING_DIM=512
KB_SIMILARITY_METRIC=COSINE
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_BATCH_SIZE=64
KB_TOP_K=5
KB_DB_PATH=knowledge/data/milvus_lite.db
KB_COLLECTION_NAME=medical_knowledge

# ----- RAG 重排序配置（可选，默认关闭）-----
# 开启后检索变为两阶段：向量召回 RERANK_CANDIDATE_K 条候选，再经 CrossEncoder 精排返回 top_k
# 首次开启时自动下载重排序模型（bge-reranker-base 约 280MB），之后离线可用
RERANK_ENABLED=false
# 重排序模型（可更换为 BAAI/bge-reranker-v2-m3 等更强模型）
RERANK_MODEL=BAAI/bge-reranker-base
# 向量召回候选数量（精排前的候选池大小）
RERANK_CANDIDATE_K=15

# ----- Mem0 配置 (长期记忆，可选) -----
MEM0_API_KEY=

# ----- 短期记忆后端（memory=进程内存，重启丢失 / redis=Redis 持久化，重启存活） -----
# 选择 redis 时，Web 对话页/AgentLoop 的会话短期记忆将写入 Redis（stm:* 键）
MEMORY_BACKEND=memory
# 会话短期记忆过期秒数（仅 redis 后端生效；滑动过期：每次追加消息刷新，0=永不过期）
STM_SESSION_TTL_SECONDS=86400

# ----- Redis 配置 (MEMORY_BACKEND=redis 时使用) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ----- 评估 LLM Judge 配置 (可选，不设置则复用 LLM 配置) -----
# EVAL_LLM_MODEL_NAME=gpt-4o-mini
# EVAL_LLM_TEMPERATURE=0.1

# ----- 专家审核配置 -----
REVIEW_ENABLED=true
REVIEW_REALTIME_ENABLED=false
REVIEW_ASYNC_SAMPLE_RATE=0.05
REVIEW_REALTIME_TIMEOUT=15
REVIEW_DATA_PATH=review/data/pending_reviews.json
